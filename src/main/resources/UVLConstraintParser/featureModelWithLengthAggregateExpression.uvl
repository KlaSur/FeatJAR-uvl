features
    Sandwich
        mandatory
            String Bread {Sorte 'Gerste'}
        optional
            Sauce
                or
                    Ketchup {Calories 100, Sugar 20}
                    Mustard 
            Integer Cheese
                or
                    Cheddar 
                    Gouda
                    Goat 
            Pickle 
            
constraints
    len(Bread) > 5